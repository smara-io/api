# Copy to .env and fill in your values
# Never commit .env

# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgresql://smara:smara@localhost:5433/smara
REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=3010

# Auth (required — generate with: openssl rand -hex 32)
JWT_SECRET=

# Embeddings (one of these required)
VOYAGE_API_KEY=              # Voyage AI — recommended (voyage-3, 1024-dim)
OPENAI_API_KEY=sk-...        # OpenAI fallback

# ── Optional ──────────────────────────────────────────────────

# Stripe billing (only needed for hosted/paid tiers)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...       # Pro $19/mo
STRIPE_PRICE_TEAM=price_...      # Team $89/mo

# Email (signup confirmation via Resend)
RESEND_API_KEY=

# Admin
ADMIN_API_KEY=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
